@eventually_uniform_prescribedUniversalChannel_payoff : ∀ {d : ℕ},
  1 ≤ d →
    ∀ (K : Set (SimpleSpectrum (d + 1))),
      IsCompact K →
        ∀ (m : ℕ → ℕ) (γ : ℝ),
          1 < γ →
            Tendsto (fun n => ↑(m n) / ↑n) atTop (𝓝 γ) →
              ∀ (ε : ℝ),
                0 < ε →
                  ∀ᶠ (n : ℕ) in atTop,
                    ∀ p ∈ K,
                      ∀ (U : ↥(unitary (Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ))),
                        |spectrumPayoff n (m n) (prescribedUniversalChannel n (m n) d) p U - universalValue γ p| < ε
prescribedUniversalChannel_covariant : ∀ (n m d : ℕ) (U : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ),
  Uᴴ * U = 1 →
    ∀ (X : TraceClass ↥(TensorRegister n (Fin (d + 1)))),
      (prescribedUniversalChannel n m d).toLinearMap ((conjugationLinearMap (tensorOperator n U)) X) =
        (conjugationLinearMap (tensorOperator m U)) ((prescribedUniversalChannel n m d).toLinearMap X)
@unknownSpectrumValue_tendsto_affine : ∀ {d : ℕ},
  1 ≤ d →
    ∀ (K : Set (SimpleSpectrum (d + 1))),
      IsCompact K →
        K.Nonempty →
          closure (interior (SimpleSpectrum.toAffine '' K)) = SimpleSpectrum.toAffine '' K →
            ∀ (m : ℕ → ℕ) (γ : ℝ),
              1 < γ →
                Tendsto (fun n => ↑(m n) / ↑n) atTop (𝓝 γ) →
                  Tendsto (fun n => unknownSpectrumValue n (m n) K) atTop (𝓝 (⨅ p, universalValue γ ↑p))
@SimpleSpectrum.mk : {d : ℕ} →
  (eigenvalue : Fin d → ℝ) →
    (∀ (i : Fin d), 0 < eigenvalue i) → StrictAnti eigenvalue → ∑ i, eigenvalue i = 1 → SimpleSpectrum d
SpectralAffine : ℕ → Type
@QuantumChannel.mk : {H : Type u_1} →
  {K : Type u_2} →
    [inst : NormedAddCommGroup H] →
      [inst_1 : InnerProductSpace ℂ H] →
        [inst_2 : CompleteSpace H] →
          [inst_3 : NormedAddCommGroup K] →
            [inst_4 : InnerProductSpace ℂ K] →
              [inst_5 : CompleteSpace K] →
                (toPositiveTracePreservingMap : PositiveTracePreservingMap H K) →
                  IsCompletelyPositive toPositiveTracePreservingMap.toLinearMap → QuantumChannel H K
@PositiveTracePreservingMap.mk : {H : Type u_1} →
  {K : Type u_2} →
    [inst : NormedAddCommGroup H] →
      [inst_1 : InnerProductSpace ℂ H] →
        [inst_2 : CompleteSpace H] →
          [inst_3 : NormedAddCommGroup K] →
            [inst_4 : InnerProductSpace ℂ K] →
              [inst_5 : CompleteSpace K] →
                (toLinearMap : TraceClass H →ₗ[ℂ] TraceClass K) →
                  (∀ (A : TraceClass H), 0 ≤ ↑A → 0 ≤ ↑(toLinearMap A)) →
                    (∀ (A : TraceClass H),
                        InfiniteTraceClass.trace ↑(toLinearMap A) ⋯ = InfiniteTraceClass.trace ↑A ⋯) →
                      PositiveTracePreservingMap H K
@IsCompletelyPositive : {H : Type u_1} →
  {K : Type u_2} →
    [inst : NormedAddCommGroup H] →
      [inst_1 : InnerProductSpace ℂ H] →
        [inst_2 : CompleteSpace H] →
          [inst_3 : NormedAddCommGroup K] →
            [inst_4 : InnerProductSpace ℂ K] → [inst_5 : CompleteSpace K] → (TraceClass H →ₗ[ℂ] TraceClass K) → Prop
@MatrixFidelity.State.mk : {n : Type u_1} →
  [inst : Fintype n] → (matrix : Matrix n n ℂ) → matrix.PosSemidef → matrix.trace = 1 → MatrixFidelity.State n
